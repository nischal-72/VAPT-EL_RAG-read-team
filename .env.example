# Copy to .env. Never commit .env.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=mistral:7b-instruct-q4_0
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5

# Token budget (PRD §7)
TOP_K=3
CHUNK_TOKENS=400
NUM_PREDICT=128

# Defense toggles (PRD Day 5)
DEFENSE_INPUT_SANITIZER=false
DEFENSE_OUTPUT_GUARD=false

# Full chunk and prompt text in logs. Hashes and summaries when false.
DEBUG_TRACE=false

# Keep third-party telemetry off
ANONYMIZED_TELEMETRY=false
LANGCHAIN_TRACING_V2=false
